# Copy this file to .env in the backend/ folder.
#
# Lokii99/zaraaqtest is a public Hugging Face model, so no API key is
# required to download or run it. These settings are optional tuning
# knobs, not credentials.

# Language hint passed to the Whisper-based Zaraaq pipeline.
# The notebook's own test recordings were Tamil/Tanglish (its raw output
# contained the "<|ta|>" language tag) - if you plan to demo in
# Tamil/Tanglish rather than English, set this to "ta".
ASR_LANGUAGE=en

# Only needed if Lokii99/zaraaqtest is ever changed to a gated/private
# Hugging Face repo. Leave blank for the public model.
HUGGINGFACE_TOKEN=
